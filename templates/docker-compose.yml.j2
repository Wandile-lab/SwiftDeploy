version: '3.8'

services:
  api-service:
    image: {{ services.image }}
    environment:
      - MODE={{ services.mode }}
      - APP_PORT={{ services.port }}
      - APP_VERSION={{ services.version }}
    networks:
      - {{ network.name }}
    restart: always
    # Security: Non-root user
    user: "1001"
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ services.port }}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 3
    volumes:
      - app_logs:/app/logs

  nginx:
    image: {{ nginx.image }}
    ports:
      - "{{ nginx.port }}:{{ nginx.port }}"
    depends_on:
      - api-service
    networks:
      - {{ network.name }}
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro

networks:
  {{ network.name }}:
    driver: {{ network.driver_type }}

volumes:
  app_logs:
