#!/usr/bin/env python3
import sys
import yaml
import subprocess
import os
from jinja2 import Template

MANIFEST_FILE = "manifest.yaml"

def load_manifest():
    with open(MANIFEST_FILE, 'r') as f:
        return yaml.safe_load(f)

def save_manifest(data):
    with open(MANIFEST_FILE, 'w') as f:
        yaml.dump(data, f)

def init():
    print("Generating configurations from templates...")
    data = load_manifest()
    
    # 1. Generate docker-compose.yml
    with open('templates/docker-compose.yml.j2') as f:
        tmpl = Template(f.read())
    with open('docker-compose.yml', 'w') as f:
        f.write(tmpl.render(data))

    # 2. Generate nginx.conf
    with open('templates/nginx.conf.j2') as f:
        tmpl = Template(f.read())
    with open('nginx.conf', 'w') as f:
        f.write(tmpl.render(data))
    
    print("Configs generated.")

def validate():
    print("Running 5 pre-flight checks...")
    data = load_manifest()
    
    # Check 1: Manifest exists
    c1 = os.path.exists(MANIFEST_FILE)
    
    # Check 2: Fields not empty
    try:
        c2 = all([data['services']['image'], data['nginx']['port'], data['services']['port']])
    except KeyError:
        c2 = False

    # Check 3: Docker image exists locally
    image_name = data['services']['image']
    c3 = subprocess.run(["docker", "inspect", image_name], capture_output=True).returncode == 0
    
    # Check 4: Port not bound on host
    nginx_port = data['nginx']['port']
    # If netstat is missing, we check if we can bind to it or just check return code
    port_check = subprocess.run(f"netstat -tuln | grep :{nginx_port}", shell=True, capture_output=True)
    c4 = port_check.returncode != 0 # If returncode is 1, grep found nothing (Port is free)

    # Check 5: Nginx syntax (with your new logic)
    c5 = False
    if os.path.exists("nginx.conf"):
        result = subprocess.run([
            "docker", "run", "--rm", 
            "-v", f"{os.getcwd()}/nginx.conf:/etc/nginx/nginx.conf:ro", 
            "nginx:latest", "nginx", "-t"
        ], capture_output=True, text=True)
        
        # Pass if exit code is 0 OR it's just the isolated DNS issue we talked about
        if result.returncode == 0 or "host not found in upstream" in result.stderr:
            c5 = True
        else:
            print(f"Nginx Error Details: {result.stderr}")

    results = [c1, c2, c3, c4, c5]
    names = ["Manifest exists", "Required fields present", "Docker image found", "Nginx port free", "Nginx syntax valid"]
    
    for name, res in zip(names, results):
        print(f"{'✅' if res else '❌'} {name}")
    
    if not all(results):
        print("\nValidation failed. Please fix the errors above.")
        sys.exit(1)

def deploy():
    validate()
    print("Bringing up the stack...")
    # --wait is a newer feature, so we use -d then check healthz
    subprocess.run(["docker-compose", "up", "-d"])
    print("Waiting for health checks (timeout 60s)...")
    
    # Simple wait loop
    import time
    start = time.time()
    while time.time() - start < 60:
        check = subprocess.run(["curl", "-s", "http://localhost:8080/healthz"], capture_output=True)
        if check.returncode == 0:
            print("Stack is healthy and responding!")
            return
        time.sleep(5)
    
    print("imeout reached. Check logs with 'docker-compose logs'")

def promote(mode):
    if mode not in ["stable", "canary"]:
        print("❌ Error: Use 'stable' or 'canary'")
        return
    
    print(f"🔄 Promoting to {mode}...")
    data = load_manifest()
    data['services']['mode'] = mode
    save_manifest(data)
    
    init() # Regenerate docker-compose.yml with new MODE env var
    
    # Rolling restart of the API service only
    subprocess.run(["docker-compose", "up", "-d", "--no-deps", "api-service"])
    print(f"Promoted to {mode}. Verification:")
    subprocess.run(["curl", "-i", "http://localhost:8080/"])

def teardown(clean=False):
    print("Tearing down all resources...")
    subprocess.run(["docker-compose", "down", "-v"])
    if clean:
        print("Deleting generated config files...")
        for f in ["docker-compose.yml", "nginx.conf"]:
            if os.path.exists(f): os.remove(f)

def main():
    if len(sys.argv) < 2:
        print("Usage: ./swiftdeploy [init|validate|deploy|promote|teardown]")
        return

    cmd = sys.argv[1]
    if cmd == "init": init()
    elif cmd == "validate": validate()
    elif cmd == "deploy": deploy()
    elif cmd == "promote": 
        if len(sys.argv) < 3:
            print("Usage: ./swiftdeploy promote [stable|canary]")
        else:
            promote(sys.argv[2])
    elif cmd == "teardown":
        clean = "--clean" in sys.argv
        teardown(clean)
    else:
        print(f"Unknown command: {cmd}")

if __name__ == "__main__":
    main()
